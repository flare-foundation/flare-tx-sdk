{
  "compilerOptions": {
    "outDir": "build",
    "module": "commonjs",
    "target": "ES2015",
    "lib": ["dom", "es2016"],
    "declaration": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "declarationMap": true,
    "noFallthroughCasesInSwitch": true,
    "strict": false,
    "strictFunctionTypes": true,
    "esModuleInterop": true,
    "typeRoots": ["dist/**", "./node_modules/@types"]
  },
  "exclude": ["node_modules", "dist", "build"],
  "typeAcquisition": {
    "enable": true,
    "exclude": ["bn.js"]
  }
}
